{
  "name": "logward-tracking-mapping",
  "version": "1.0.0",
  "description": "Logward Tracking Mapping Automation — AIR / OCEAN / ROAD (Shippeo → Logward)",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:air": "npx playwright test --project=air",
    "test:ocean": "npx playwright test --project=ocean",
    "test:road": "npx playwright test --project=road",
    "test:events": "node scripts/runEventTests.js",
    "e2e:session": "node scripts/e2eSession.js",
    "report": "npx playwright show-report",
    "report:air": "npx playwright show-report playwright-report/air",
    "report:ocean": "npx playwright show-report playwright-report/ocean",
    "report:road": "npx playwright show-report playwright-report/road"
  },
  "keywords": [
    "playwright",
    "automation",
    "logward",
    "tracking",
    "mapping"
  ],
  "author": "Logward QA",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "amazon-cognito-identity-js": "^6.3.16",
    "dotenv": "^17.4.2"
  }
}
