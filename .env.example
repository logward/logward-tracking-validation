# ╔══════════════════════════════════════════════════════════════════════╗
#  LOGWARD E2E — CREDENTIALS TEMPLATE
#  Copy this file to .env and fill in real values.
#  The .env file is gitignored — never commit actual credentials.
#
#  Quick start:
#    cp .env.example .env
#    # Fill in LOGWARD_PASSWORD, SHIPPEO_PASSWORD, QA_WEBHOOK_TOKEN
#    # Ocean tests: run  node helpers/e2e/seedShippeoToken.js  once per day
#    # Air tests: paste a fresh AIR_ADMIN_TOKEN from DevTools before each run
# ╚══════════════════════════════════════════════════════════════════════╝

# ── Environment selection ──────────────────────────────────────────────
# Options: qa | sandbox | prod
E2E_ENV=qa

# ── Logward Admin Credentials (used by cognitoAuth.js to auto-login) ──
# Cognito access tokens auto-refresh — just set your credentials once
LOGWARD_USERNAME=your.email@logward.com
LOGWARD_PASSWORD=your-logward-password

# ── QA — Webhook Token (long-lived, expires 2027) ────────────────────
# Provided by Logward team — only changes if rotated
QA_WEBHOOK_TOKEN=eyJ...

# ── Sandbox ───────────────────────────────────────────────────────────
SANDBOX_ADMIN_TOKEN=eyJ...
SANDBOX_WEBHOOK_TOKEN=eyJ...

# ── Production ────────────────────────────────────────────────────────
PROD_ADMIN_TOKEN=eyJ...
PROD_WEBHOOK_TOKEN=eyJ...

# ── Shippeo Credentials (used by shippeoAuth.js) ─────────────────────
# Token is auto-managed — run seedShippeoToken.js once per session
SHIPPEO_API_BASE_URL=
SHIPPEO_CLIENT_ID=
SHIPPEO_USERNAME=your.email@shippeo.com
SHIPPEO_PASSWORD=your-shippeo-password

# ── Air Tracking ──────────────────────────────────────────────────────
# AIR_ADMIN_TOKEN expires every ~1 hour:
#   1. Log in to https://qa-admin.logward.engineering
#   2. DevTools → Network → any request → Authorization header → copy Bearer value
AIR_ADMIN_TOKEN=eyJ...
AIR_WEBHOOK_TOKEN=eyJ...

# ── Road Tracking ─────────────────────────────────────────────────────
ROAD_ADMIN_TOKEN=eyJ...
ROAD_WEBHOOK_TOKEN=eyJ...
