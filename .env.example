# ─── AIR ─────────────────────────────────────────────────────────────────────
# Cognito admin token — expires ~1 hour. Copy from DevTools → Network → Authorization header.
AIR_ADMIN_TOKEN=eyJ...
# Long-lived webhook token (exp ~2027)
AIR_WEBHOOK_TOKEN=eyJ...

# ─── OCEAN ───────────────────────────────────────────────────────────────────
OCEAN_ADMIN_TOKEN=eyJ...
OCEAN_WEBHOOK_TOKEN=eyJ...

# ─── ROAD ────────────────────────────────────────────────────────────────────
ROAD_ADMIN_TOKEN=eyJ...
ROAD_WEBHOOK_TOKEN=eyJ...
